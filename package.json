{
  "name": "pawcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, extensible AI coding agent for the terminal",
  "bin": {
    "paw": "./dist/cli.js",
    "pawcode": "./dist/cli.js"
  },
  "scripts": {
    "dev": "node -r dotenv/config --import tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node -r dotenv/config dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}

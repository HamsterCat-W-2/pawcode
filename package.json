{
  "name": "pawcode",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A small, extensible AI coding agent for the terminal",
  "bin": {
    "paw": "./dist/cli.js",
    "pawcode": "./dist/cli.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}

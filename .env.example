# PawCode 使用统一字段；只需要修改值即可切换供应商和模型。
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=replace-with-your-api-key

# 自定义 OpenAI-compatible 服务额外设置地址：
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=optional-for-local-services
MAX_AGENT_TURNS=10
MAX_TOOL_OUTPUT_CHARS=20000
CONTEXT_COMPACT_THRESHOLD=0.8
CONTEXT_KEEP_RECENT_TOKENS=20000
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_DELAY_MS=500
